Description: Q6A probe - CSID clock floor only (400 MHz)
 Diagnostic-only patch: adds nothing but the two CSID clock floor sites from
 camx-dlkm-q6a-settle-sof.patch.  Used to isolate whether the floor alone (and
 not the other hunks of that patch) is what stalls IMX577 streaming on Q6A.
 NOT enabled in debian/patches/series by default.
Author: Chongbiao Chen <chenchongbiao@radxa.com>
Forwarded: not-needed
Last-Update: 2026-09-30

diff --git a/src/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/ife_csid_hw/cam_ife_csid_core.c b/src/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/ife_csid_hw/cam_ife_csid_core.c
index d865c1c1..b758cdd2 100644
--- a/src/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/ife_csid_hw/cam_ife_csid_core.c
+++ b/src/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/ife_csid_hw/cam_ife_csid_core.c
@@ -1492,6 +1492,9 @@ static int cam_ife_csid_enable_hw(struct cam_ife_csid_hw  *csid_hw)
 	CAM_DBG(CAM_ISP, "CSID:%d init CSID HW",
 		csid_hw->hw_intf->hw_idx);
 
+	if (csid_hw->clk_rate < 400000000ULL)
+		csid_hw->clk_rate = 400000000ULL;
+
 	rc = cam_soc_util_get_clk_level(soc_info, csid_hw->clk_rate,
 		soc_info->src_clk_idx, &clk_lvl);
 	if (rc) {
@@ -4392,6 +4395,11 @@ static int cam_ife_csid_set_csid_clock(
 		(struct cam_ife_csid_clock_update_args *)cmd_args;
 
 	csid_hw->clk_rate = clk_update->clk_rate;
+	if (csid_hw->clk_rate < 400000000ULL) {
+		pr_err("CAM-CSID-DBG: clk_rate %llu too low, bump to 400000000\n",
+			csid_hw->clk_rate);
+		csid_hw->clk_rate = 400000000ULL;
+	}
 	CAM_INFO(CAM_ISP, "CSID clock rate %llu", csid_hw->clk_rate);
 
 	return 0;
